<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.xtechcn.cloud.upms.mapper.SysUserDeptRelMapper">

    <resultMap id="userDeptRelVoMap" type="com.xtechcn.cloud.upms.model.vo.UserDeptRelVo">
        <result property="userId" column="user_id"/>
        <result property="deptId" column="dept_id"/>
        <result property="deptName" column="dept_name"/>
        <result property="position" column="position"/>
        <result property="pid" column="pid"/>
        <result property="level" column="level"/>
    </resultMap>

    <resultMap id="userInfoVoMap" type="com.xtechcn.cloud.upms.model.UserInfoModel">
        <result property="userId" column="user_id"/>
        <result property="username" column="username"/>
        <result property="phone" column="phone"/>
        <result property="nickname" column="nickname"/>
        <result property="avatar" column="avatar"/>
        <result property="position" column="position"/>
        <result property="enabled" column="enabled"/>
    </resultMap>

    <!-- 查询用户部门关系数据数据集合 -->
    <select id="selectUserDeptRels" resultMap="userDeptRelVoMap">
        SELECT `join_dept`.`user_id`,
               `join_dept`.`dept_id`,
               `join_dept`.`position`,
               `name` AS `dept_name`,
               `pid`,
               `level`
        FROM `upms_sys_user_dept_rel` AS `join_dept`
                 LEFT JOIN `upms_sys_dept` AS `dept` ON `join_dept`.`dept_id` = `dept`.`id`
        WHERE `dept`.`is_delete` = 0
          AND `join_dept`.`user_id` = #{userId}
    </select>

    <!-- 查询部门下的用户 -->
    <select id="selectUsersByDeptId" resultMap="userInfoVoMap">
        SELECT `join_dept`.`user_id`,
               `join_dept`.`dept_id`,
               `join_dept`.`position`,
               `user`.`phone`,
               `user`.`nickname`,
               `user`.`avatar`,
               `user`.`enabled`
        FROM `upms_sys_user_dept_rel` AS `join_dept`
                 LEFT JOIN `upms_tob_sys_user` AS `user` ON `join_dept`.`user_id` = `user`.`user_id`
        WHERE `user`.`is_delete` = 0
          AND `join_dept`.`dept_id` = #{deptId}
    </select>

</mapper>
